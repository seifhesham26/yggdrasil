# Neon PostgreSQL connection string used by Drizzle and Better Auth.
DATABASE_URL=postgresql://owner:password@example.neon.tech/neondb?sslmode=verify-full

# At least 32 characters; keep this secret outside source control.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Canonical URL used to generate Better Auth callback and cookie URLs.
BETTER_AUTH_URL=http://localhost:3000

# Absolute directory where imported models and generated files are stored.
YGGDRASIL_ASSET_ROOT=C:\dev\yggdrasil-data

# Email address permitted to create the one and only owner account.
YGGDRASIL_OWNER_EMAIL=owner@example.test
